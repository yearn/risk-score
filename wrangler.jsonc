{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "risk-score",
  "main": "worker.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist", "binding": "ASSETS", "html_handling": "none" },
  "workers_dev": true,
  "env": { "preview": { "workers_dev": true } }
}
