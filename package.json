{
  "name": "risk-score-frontend",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/update_stats.mjs && node scripts/check_bridges.mjs && node scripts/check_graphs.mjs && astro dev",
    "build": "node scripts/update_stats.mjs && node scripts/check_bridges.mjs && node scripts/check_graphs.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "update-stats": "node scripts/update_stats.mjs",
    "check-bridges": "node scripts/check_bridges.mjs --strict",
    "check-graphs": "node scripts/check_graphs.mjs --strict"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "11.0.8",
    "@plausible-analytics/tracker": "0.4.6",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.2.6",
    "cytoscape": "3.34.1",
    "cytoscape-dagre": "4.0.0",
    "cytoscape-dom-node": "2.1.0",
    "js-yaml": "4.3.0",
    "marked": "18.0.11",
    "satori": "0.29.0"
  }
}
